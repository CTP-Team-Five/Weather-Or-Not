# Supabase (optional — app works without these, falls back to localStorage)
# Both vars are intentionally NEXT_PUBLIC_ because the Supabase anon key is
# safe to expose in the browser (row-level security enforces access control).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Unsplash (optional — without it, hero photos fall back to the curated
# static defaults in /public/backgrounds/*). Free tier is 50 req/hr at the
# "Demo" level; apply for production access (5000 req/hr) before launch.
# Get one at https://unsplash.com/oauth/applications
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=your-unsplash-access-key
